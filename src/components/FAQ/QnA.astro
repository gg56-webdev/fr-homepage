  0: (content) => `<p>${content}</p>`,
  1: (content) => `<em>${content}</em>`
})
const faq71 = interpolateComponents(t('faq.q&a.7.1') as string, {
  0: (content) => `<p>${content}</p>`
})
const faq81 = interpolateComponents(t('faq.q&a.8.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<a href="https://gg56.com/" target="_blank" rel="noopener noreferrer">${content}</a>`
})
const faq91 = interpolateComponents(t('faq.q&a.9.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<ol>${content}</ol>`,
  2: (content) => `<li>${content}</li>`,
  3: (content) => `<li>${content}</li>`,
  4: (content) => `<li>${content}</li>`,
  5: (content) => `<li>${content}</li>`,
  6: (content) => `<li>${content}</li>`,
  7: (content) => `<li>${content}</li>`
})
const faq101 = interpolateComponents(t('faq.q&a.10.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<a href="${SOCIAL_LINKS.INSTAGRAM.href}" target="_blank" rel="noopener noreferrer">${content}</a>`,
  2: (content) => `<a href="${SOCIAL_LINKS.FACEBOOK.href}" target="_blank" rel="noopener noreferrer">${content}</a>`,
  3: (content) => `<a href="${SOCIAL_LINKS.X.href}" target="_blank" rel="noopener noreferrer">${content}</a>`,
  4: (content) => `<a href="${SOCIAL_LINKS.TELEGRAM.href(locale)}" target="_blank" rel="noopener noreferrer">${content}</a>`,
  5: (content) => `<a href="${SOCIAL_LINKS.LINKEDIN.href}" target="_blank" rel="noopener noreferrer">${content}</a>`
})
const faq111 = interpolateComponents(t('faq.q&a.11.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<a href="${APP_STORE_URL}" target="_blank" rel="noopener noreferrer">${content}</a>`,
  2: (content) => `<a href="${GOOGLE_PLAY_URL}" target="_blank" rel="noopener noreferrer">${content}</a>`
})
const faq121 = interpolateComponents(t('faq.q&a.12.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<a href="mailto:shokun51@gg56.world">${content}</a>`,
  2: (content) => `<a href="${localizePath(NAV_LINKS.CONTACT.href, locale)}">${content}</a>`
})
const faq131 = interpolateComponents(t('faq.q&a.13.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<p>${content}</p>`,
  2: (content) => `<a href="${NAV_LINKS.PRIVACY.href}">${content}</a>`,
  3: (content) => `<a href="${localizePath(NAV_LINKS.TERMS.href, locale)}">${content}</a>`,
  4: (content) => `<p>${content}</p>`
})
const faq141 = interpolateComponents(t('faq.q&a.14.1') as string, {
  0: (content) => `<p>${content}</p>`
})
---

<section>
  <h1 class="text-4xl font-bold text-center mb-8">FAQ</h1>
  <div class="space-y-4">
    <Accordion id="what-is-som" name="q&a" title={t('faq.q&a.0.0') as string}>
      <span set:html={faq01} />
    </Accordion>
    <Accordion name="q&a" title={t('faq.q&a.1.0') as string}>
      <span set:html={faq11} />
    </Accordion>
    <Accordion name="q&a" title={t('faq.q&a.2.0') as string}>
      <span set:html={faq21} />
    </Accordion>
    <Accordion name="q&a" title={t('faq.q&a.3.0') as string}>
