---
import Accordion from '@/components/FAQ/Accordion.astro'
import { APP_STORE_URL, GOOGLE_PLAY_URL, NAV_LINKS, SOCIAL_LINKS } from '@/constants'
import { useTranslations, getLocale, localizePath, interpolateComponents } from '@/i18n'

const locale = getLocale(Astro)
const { t } = useTranslations(locale)

// Prepare interpolated FAQ content
const faq01 = interpolateComponents(t('faq.q&a.0.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<em>${content}</em>`,
  2: (content) => `<small class="block">${content}</small>`
})
const faq11 = interpolateComponents(t('faq.q&a.1.1') as string, {
  0: (content) => `<p>${content}</p>`
})
const faq21 = interpolateComponents(t('faq.q&a.2.1') as string, {
  0: (content) => `<p>${content}</p>`
})
const faq31 = interpolateComponents(t('faq.q&a.3.1') as string, {
  0: (content) => `<p>${content}</p>`
})
const faq41 = interpolateComponents(t('faq.q&a.4.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<ul>${content}</ul>`,
  2: (content) => `<li>${content}</li>`,
  3: (content) => `<li>${content}</li>`,
  4: (content) => `<li>${content}</li>`,
  5: (content) => `<li>${content}</li>`,
  6: (content) => `<li>${content}</li>`,
  7: (content) => `<small>${content}</small>`
})
const faq51 = interpolateComponents(t('faq.q&a.5.1') as string, {
  0: (content) => `<p>${content}</p>`,
  1: (content) => `<ul>${content}</ul>`,
  2: (content) => `<li>${content}</li>`,
  3: (content) => `<li>${content}</li>`,
  4: (content) => `<li>${content}</li>`,
  5: (content) => `<small>${content}</small>`
})
