---
import Coupons from '@/components/how-it-works/Coupons.astro'
import Cta from '@/components/how-it-works/Cta.astro'
import Hero from '@/components/how-it-works/Hero.astro'
import HowAppWorks from '@/components/how-it-works/HowAppWorks.astro'
import Missions from '@/components/how-it-works/Missions.astro'
import Layout from '@/layouts/Layout.astro'
import { useTranslations, getLocale } from '@/i18n'

const locale = getLocale(Astro)
const { t } = useTranslations(locale)
---

<Layout image="/og/faq.jpg" title={t('seo.how-it-works.title')!}>
  <div class="space-y-12 py-12 md:space-y-24 lg:space-y-32 md:pb-24 overflow-hidden">
    <Hero />
    <HowAppWorks />
    <Missions />
    <Coupons />
    <Cta />
  </div>
</Layout>
