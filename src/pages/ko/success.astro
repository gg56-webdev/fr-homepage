---
import { useTranslations, localizePath, getLocale } from '@/i18n';
import { NAV_LINKS } from "@/constants";
import Layout from "@/layouts/Layout.astro";

const locale = getLocale(Astro)
const { t } = useTranslations(locale)
---

<Layout title={t('contact-form.success.h1')!}>
  <section class="py-24 text-center">
    <h1 class="mb-4 text-4xl font-bold">
      {t('contact-form.success.h1')}
    </h1>
    <p class="text-lg mb-2">{t('contact-form.success.p')}</p>
    <a href={localizePath(NAV_LINKS.HOME.href, locale)} class="hover:underline">{t('common.go-home')} ↗</a>
  </section>
</Layout>
